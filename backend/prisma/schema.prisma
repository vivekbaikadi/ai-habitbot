generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// USER ENUMS
// ─────────────────────────────────────────────

enum Sex {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  VERY_ACTIVE
  EXTRA_ACTIVE
}

enum PrimaryGoal {
  WEIGHT_LOSS
  WEIGHT_MAINTENANCE
  MUSCLE_GAIN
  GENERAL_HEALTH
}

enum DietType {
  VEGETARIAN
  NON_VEGETARIAN
  EGGETARIAN
  VEGAN
}

// Habit Enums

enum HabitFrequency {
  DAILY
  WEEKLY
  CUSTOM
}

// ─────────────────────────────────────────────
// FOOD ENUMS
// ─────────────────────────────────────────────

enum FoodType {
  BASIC
  PREPARED_DISH
}

enum NutrientCategory {
  MACRONUTRIENT
  VITAMIN
  MINERAL
  OTHER
}

enum FoodLogMealType {
  BREAKFAST
  MORNING_SNACK
  LUNCH
  EVENING_SNACK
  DINNER
  OTHER
}

// ─────────────────────────────────────────────
// AI CONVERSATIONS
// ─────────────────────────────────────────────

enum AIMessageRole {
  USER
  ASSISTANT
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id           String @id @default(uuid())
  name         String
  email        String @unique
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile           UserProfile?
  dietaryPreference DietaryPreference?
  foodDislikes      UserFoodDislike[]
  foodLogs          FoodLog[]
  sessions          RefreshSession[]

  goals  UserGoal[]
  habits Habit[]

  aiConversations AIConversation[]
}

model UserGoal {
  id     String @id @default(uuid())
  userId String

  title       String
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  habits Habit[]

  @@index([userId])
  @@index([userId, isActive])
}

model RefreshSession {
  id     String @id @default(uuid())
  userId String

  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────
// HABITS
// ─────────────────────────────────────────────

model Habit {
  id     String  @id @default(uuid())
  userId String
  goalId String?

  name        String
  description String?

  isActive Boolean @default(true)

  // Target configuration
  targetValue Decimal? @db.Decimal(10, 2)
  targetUnit  String?

  // Scheduling
  frequency HabitFrequency @default(DAILY)

  startDate DateTime
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal UserGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  completions HabitCompletion[]

  @@index([userId])
  @@index([userId, isActive])
  @@index([goalId])
}

model HabitCompletion {
  id      String @id @default(uuid())
  habitId String

  completedAt DateTime

  value Decimal? @db.Decimal(10, 2)
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([habitId, completedAt])
}

// ─────────────────────────────────────────────
// USER PROFILE
// ─────────────────────────────────────────────

model UserProfile {
  id     String @id @default(uuid())
  userId String @unique

  dateOfBirth DateTime?
  sex         Sex?

  heightCm Decimal? @db.Decimal(5, 2)
  weightKg Decimal? @db.Decimal(5, 2)

  activityLevel ActivityLevel?
  primaryGoal   PrimaryGoal?

  timezone String @default("Asia/Kolkata")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// DIETARY PREFERENCE
// ─────────────────────────────────────────────

model DietaryPreference {
  id       String   @id @default(uuid())
  userId   String   @unique
  dietType DietType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// USER FOOD DISLIKE
// ─────────────────────────────────────────────

model UserFoodDislike {
  id     String @id @default(uuid())
  userId String
  foodId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([userId, foodId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// FOOD
// ─────────────────────────────────────────────

model Food {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  foodType FoodType
  dietType DietType

  categoryId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category FoodCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  aliases  FoodAlias[]
  portions FoodPortion[]

  nutritionProfiles NutritionProfile[]

  userDislikes UserFoodDislike[]
  logItems     FoodLogItem[]

  @@index([name])
  @@index([dietType])
  @@index([foodType])
  @@index([categoryId])
}

// ─────────────────────────────────────────────
// FOOD CATEGORY
// ─────────────────────────────────────────────

model FoodCategory {
  id   String @id @default(uuid())
  name String
  slug String @unique

  parentId String?

  parent   FoodCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children FoodCategory[] @relation("CategoryHierarchy")

  foods Food[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

// ─────────────────────────────────────────────
// FOOD ALIAS
// ─────────────────────────────────────────────

model FoodAlias {
  id     String @id @default(uuid())
  foodId String
  alias  String

  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([foodId, alias])
  @@index([alias])
}

// ─────────────────────────────────────────────
// FOOD PORTION
// ─────────────────────────────────────────────

model FoodPortion {
  id     String @id @default(uuid())
  foodId String

  name  String
  grams Decimal @db.Decimal(8, 2)

  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([foodId, name])
  @@index([foodId])
}

// ─────────────────────────────────────────────
// NUTRITION SOURCE
// ─────────────────────────────────────────────

model NutritionSource {
  id          String  @id @default(uuid())
  name        String
  version     String?
  description String?

  nutritionProfiles NutritionProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// NUTRIENT
// ─────────────────────────────────────────────

model Nutrient {
  id   String @id @default(uuid())
  code String @unique
  name String
  unit String

  category NutrientCategory

  nutritionItems NutritionProfileItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// NUTRITION PROFILE
// ─────────────────────────────────────────────

model NutritionProfile {
  id       String  @id @default(uuid())
  foodId   String
  sourceId String?

  basisGrams Decimal @default(100) @db.Decimal(8, 2)

  food   Food             @relation(fields: [foodId], references: [id], onDelete: Cascade)
  source NutritionSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  nutrients NutritionProfileItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([foodId])
  @@index([sourceId])
}

// ─────────────────────────────────────────────
// NUTRITION PROFILE ITEM
// ─────────────────────────────────────────────

model NutritionProfileItem {
  id         String @id @default(uuid())
  profileId  String
  nutrientId String

  value Decimal @db.Decimal(12, 4)

  profile  NutritionProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  nutrient Nutrient         @relation(fields: [nutrientId], references: [id], onDelete: Cascade)

  @@unique([profileId, nutrientId])
  @@index([nutrientId])
}

// ─────────────────────────────────────────────
// FOOD LOG
// ─────────────────────────────────────────────

model FoodLog {
  id       String          @id @default(uuid())
  userId   String
  eatenAt  DateTime
  mealType FoodLogMealType

  rawInput String?
  notes    String?

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items FoodLogItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, eatenAt])
  @@index([userId, mealType])
}

// ─────────────────────────────────────────────
// FOOD LOG ITEM
// ─────────────────────────────────────────────

model FoodLogItem {
  id        String @id @default(uuid())
  foodLogId String
  foodId    String

  quantity Decimal @db.Decimal(8, 2)
  unit     String
  grams    Decimal @db.Decimal(10, 2)

  // Nutrition snapshot at time of logging
  calories     Decimal? @db.Decimal(12, 4)
  protein      Decimal? @db.Decimal(12, 4)
  carbohydrate Decimal? @db.Decimal(12, 4)
  fat          Decimal? @db.Decimal(12, 4)
  fiber        Decimal? @db.Decimal(12, 4)

  foodLog FoodLog @relation(fields: [foodLogId], references: [id], onDelete: Cascade)
  food    Food    @relation(fields: [foodId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([foodLogId])
  @@index([foodId])
}

// ─────────────────────────────────────────────
// AI CONVERSATIONS
// ─────────────────────────────────────────────

model AIConversation {
  id     String @id @default(uuid())
  userId String

  title String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId, updatedAt])
}

model AIMessage {
  id             String @id @default(uuid())
  conversationId String

  role    AIMessageRole
  content String

  createdAt DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
